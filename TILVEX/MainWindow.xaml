<Window x:Class="TILVEX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TILVEX POS" Height="820" Width="1380" MinHeight="650" MinWidth="1050"
        Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/tilvex-icon.png"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#111827"/>
        <SolidColorBrush x:Key="NavyLightBrush" Color="#1C293B"/>
        <SolidColorBrush x:Key="InkBrush" Color="#172334"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B778A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E3E9F0"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F9F78"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#0B805E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC4C4C"/>
        <LinearGradientBrush x:Key="FuturisticSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFCFE" Offset="0.52"/>
            <GradientStop Color="#F6F8FB" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#27364A"/>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#0F9F78" BorderBrush="#0B805E" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TopNavigationMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#DCE8F5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <Path x:Name="SubmenuArrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#73DCC0"
                                          Width="8" Height="4" Stretch="Fill" Margin="8,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="#152438" BorderBrush="#36536B" BorderThickness="1" CornerRadius="8"
                                        Padding="5" Effect="{StaticResource CardShadow}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#0F9F78"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#0F9F78"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter Property="Padding" Value="11,8"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter TargetName="SubmenuArrow" Property="Data" Value="M 0 0 L 4 4 L 0 8 Z"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#66758A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="AppButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource FuturisticSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AppButton}"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Background" Value="{StaticResource FuturisticSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                Effect="{StaticResource CardShadow}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E3E9F0"
                                        BorderThickness="0,0,0,1" Padding="16,13">
                                    <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource InkBrush}"
                                                      TextElement.FontWeight="SemiBold" TextElement.FontSize="14"/>
                                </Border>
                                <ContentPresenter Margin="14"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF3"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#66758A"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderBrush" Value="#E3E9F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#E8EDF3"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#FAFBFD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F8F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DDF5EA"/>
                                <Setter Property="Foreground" Value="#145A43"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#66758A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#365D8D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#6683A7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#4778B1"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#8BA9CC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#27466B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSection" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#9AA9BA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="12,14,0,5"/>
        </Style>
        <Style x:Key="HiddenTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SaleProductItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="TileBorder" Background="#FFFFFF" BorderBrush="#E3E9F0"
                                BorderThickness="1" CornerRadius="9" Padding="13">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#0F9F78"/>
                                <Setter TargetName="TileBorder" Property="Background" Value="#F3FAF7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#0F9F78"/>
                                <Setter TargetName="TileBorder" Property="Background" Value="#E8F7F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#242424">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="26,28,22,26">
                    <Viewbox Width="42" Height="42" Stretch="Uniform" HorizontalAlignment="Left">
                        <Canvas Width="512" Height="512">
                            <Border Width="512" Height="512" CornerRadius="110" Background="{StaticResource AccentBrush}"/>
                            <Polygon Points="256,52 358,102 400,230 358,358 256,408 154,358 112,230 154,102"
                                     Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="5" Opacity="0.2"/>
                            <Rectangle Canvas.Left="130" Canvas.Top="134" Width="252" Height="58" RadiusX="14" RadiusY="14" Fill="{StaticResource NavyBrush}"/>
                            <Rectangle Canvas.Left="220" Canvas.Top="190" Width="72" Height="110" RadiusX="12" RadiusY="12" Fill="{StaticResource NavyBrush}"/>
                            <Polygon Points="220,300 292,300 368,398 292,398 254,344 220,344" Fill="{StaticResource SuccessBrush}"/>
                            <Rectangle Canvas.Left="254" Canvas.Top="330" Width="72" Height="72" RadiusX="12" RadiusY="12" Fill="{StaticResource SuccessBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TILVEX" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold" Margin="0,17,0,0"/>
                    <TextBlock Text="POINT OF SALE" Foreground="#9AA9BA" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="14,0,14,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource NavSection}"/>
                        <Button Tag="0" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="◆" Foreground="#0F9F78" Width="24"/><TextBlock Text="Dashboard"/></StackPanel>
                        </Button>

                        <TextBlock Text="SALES &amp; SERVICE" Style="{StaticResource NavSection}"/>
                        <Button Tag="1" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#0F9F78" Width="24"/><TextBlock Text="New sale"/></StackPanel>
                        </Button>
                        <Button Tag="3" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="≡" Foreground="#0F9F78" Width="24"/><TextBlock Text="Sales management"/></StackPanel>
                        </Button>
                        <Button Tag="6" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="↩" Foreground="#0F9F78" Width="24"/><TextBlock Text="Returns &amp; refunds"/></StackPanel>
                        </Button>

                        <TextBlock Text="CATALOGUE" Style="{StaticResource NavSection}"/>
                        <Button Tag="2" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="□" Foreground="#0F9F78" Width="24"/><TextBlock Text="Product management"/></StackPanel>
                        </Button>
                        <Button Tag="13" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▥" Foreground="#0F9F78" Width="24"/><TextBlock Text="Inventory management"/></StackPanel>
                        </Button>
                        <Button Tag="12" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Foreground="#0F9F78" Width="24"/><TextBlock Text="Price checker"/></StackPanel>
                        </Button>
                        <Button Tag="7" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="%" Foreground="#0F9F78" Width="24"/><TextBlock Text="Promotions &amp; VAT"/></StackPanel>
                        </Button>

                        <TextBlock Text="RELATIONSHIPS" Style="{StaticResource NavSection}"/>
                        <Button Tag="4" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="♙" Foreground="#0F9F78" Width="24"/><TextBlock Text="Customers"/></StackPanel>
                        </Button>
                        <Button Tag="5" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="♧" Foreground="#0F9F78" Width="24"/><TextBlock Text="Purchase management"/></StackPanel>
                        </Button>
                        <Button Tag="15" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⇄" Foreground="#0F9F78" Width="24"/><TextBlock Text="Customer &amp; supplier ledgers"/></StackPanel>
                        </Button>

                        <TextBlock Text="FINANCE" Style="{StaticResource NavSection}"/>
                        <Button Tag="8" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="£" Foreground="#0F9F78" Width="24"/><TextBlock Text="Till reconciliation"/></StackPanel>
                        </Button>
                        <Button Tag="14" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="−" Foreground="#0F9F78" Width="24"/><TextBlock Text="Expense management"/></StackPanel>
                        </Button>
                        <Button Tag="16" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Foreground="#0F9F78" Width="24"/><TextBlock Text="Shift management"/></StackPanel>
                        </Button>
                        <Button Tag="9" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#0F9F78" Width="24"/><TextBlock Text="Reports &amp; export"/></StackPanel>
                        </Button>

                        <TextBlock Text="ADMINISTRATION" Style="{StaticResource NavSection}"/>
                        <Button Tag="10" AutomationProperties.Name="Settings &amp; users" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="#0F9F78" Width="24"/><TextBlock Text="Settings &amp; users"/></StackPanel>
                        </Button>
                        <Button Tag="11" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⇄" Foreground="#0F9F78" Width="24"/><TextBlock Text="Database tools"/></StackPanel>
                        </Button>
                        <Button Click="SignOut_Click" Style="{StaticResource NavButton}" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="←" Foreground="#0F9F78" Width="24"/><TextBlock Text="Sign out"/></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="26,18,22,26">
                    <Border Background="{StaticResource NavyLightBrush}" CornerRadius="9" Padding="12">
                        <StackPanel><TextBlock Text="TILVEX POS" Foreground="#9AA9BA" FontSize="10" FontWeight="Bold"/><TextBlock Text="Built for daily trade" Foreground="#F8FAFC" Margin="0,4,0,0"/><TextBlock Text="v1.0 • Local edition" Foreground="#9AA9BA" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24">
