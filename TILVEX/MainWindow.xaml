<Window x:Class="TILVEX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TILVEX POS" Height="820" Width="1380" MinHeight="650" MinWidth="1050"
        Background="#0D0F14" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/tilvex-icon.png"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#0D0F14"/>
        <SolidColorBrush x:Key="NavyLightBrush" Color="#141720"/>
        <SolidColorBrush x:Key="InkBrush" Color="#E8EDF3"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#718096"/>
        <SolidColorBrush x:Key="LineBrush" Color="#26303D"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#CC141720"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D4AA"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#007A5E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#00D4AA"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#00D4AA"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.38" Color="#00D4AA"/>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#141720"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#00D4AA" BorderBrush="#007A5E" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="AppButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource NavyLightBrush}"/>
            <Setter Property="Foreground" Value="#E8EDF3"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButton}">
            <Setter Property="Background" Value="#141720"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#26303D"/>
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AppButton}"/>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#141720"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#26303D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#141720"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#141720"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#26303D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                Effect="{StaticResource CardShadow}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#B3141720" BorderBrush="#26303D"
                                        BorderThickness="0,0,0,1" Padding="16,13">
                                    <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource InkBrush}"
                                                      TextElement.FontWeight="SemiBold" TextElement.FontSize="14"/>
                                </Border>
                                <ContentPresenter Margin="14"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#141720"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#26303D"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#0D0F14"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderBrush" Value="#26303D"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="#141720"/>
                        <Setter Property="BorderBrush" Value="#26303D"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#141720"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#141720"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#007A5E"/>
                                <Setter Property="Foreground" Value="#E8EDF3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#141720"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#141720"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EDF3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#007A5E"/>
                                <Setter Property="Foreground" Value="#E8EDF3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#00D4AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavSection" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="12,14,0,5"/>
        </Style>
        <Style x:Key="HiddenTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="26,28,22,26">
                    <Viewbox Width="42" Height="42" Stretch="Uniform" HorizontalAlignment="Left">
                        <Canvas Width="512" Height="512">
                            <Border Width="512" Height="512" CornerRadius="110" Background="{StaticResource AccentBrush}"/>
                            <Polygon Points="256,52 358,102 400,230 358,358 256,408 154,358 112,230 154,102"
                                     Fill="Transparent" Stroke="#E8EDF3" StrokeThickness="5" Opacity="0.2"/>
                            <Rectangle Canvas.Left="130" Canvas.Top="134" Width="252" Height="58" RadiusX="14" RadiusY="14" Fill="{StaticResource NavyBrush}"/>
                            <Rectangle Canvas.Left="220" Canvas.Top="190" Width="72" Height="110" RadiusX="12" RadiusY="12" Fill="{StaticResource NavyBrush}"/>
                            <Polygon Points="220,300 292,300 368,398 292,398 254,344 220,344" Fill="{StaticResource SuccessBrush}"/>
                            <Rectangle Canvas.Left="254" Canvas.Top="330" Width="72" Height="72" RadiusX="12" RadiusY="12" Fill="{StaticResource SuccessBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TILVEX" Foreground="#E8EDF3" FontSize="22" FontWeight="Bold" Margin="0,17,0,0"/>
                    <TextBlock Text="POINT OF SALE" Foreground="#718096" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="14,0,14,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource NavSection}"/>
                        <Button Tag="0" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="◆" Foreground="#00D4AA" Width="24"/><TextBlock Text="Dashboard"/></StackPanel>
                        </Button>

                        <TextBlock Text="SALES &amp; SERVICE" Style="{StaticResource NavSection}"/>
                        <Button Tag="1" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#00D4AA" Width="24"/><TextBlock Text="New sale"/></StackPanel>
                        </Button>
                        <Button Tag="3" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="≡" Foreground="#00D4AA" Width="24"/><TextBlock Text="Sales history"/></StackPanel>
                        </Button>
                        <Button Tag="6" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="↩" Foreground="#00D4AA" Width="24"/><TextBlock Text="Returns &amp; refunds"/></StackPanel>
                        </Button>

                        <TextBlock Text="CATALOGUE" Style="{StaticResource NavSection}"/>
                        <Button Tag="2" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="□" Foreground="#00D4AA" Width="24"/><TextBlock Text="Products &amp; stock"/></StackPanel>
                        </Button>
                        <Button Tag="7" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="%" Foreground="#00D4AA" Width="24"/><TextBlock Text="Promotions &amp; VAT"/></StackPanel>
                        </Button>

                        <TextBlock Text="RELATIONSHIPS" Style="{StaticResource NavSection}"/>
                        <Button Tag="4" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="♙" Foreground="#00D4AA" Width="24"/><TextBlock Text="Customers"/></StackPanel>
                        </Button>
                        <Button Tag="5" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="♧" Foreground="#00D4AA" Width="24"/><TextBlock Text="Suppliers &amp; purchasing"/></StackPanel>
                        </Button>

                        <TextBlock Text="FINANCE" Style="{StaticResource NavSection}"/>
                        <Button Tag="8" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="£" Foreground="#00D4AA" Width="24"/><TextBlock Text="Till &amp; reconciliation"/></StackPanel>
                        </Button>
                        <Button Tag="9" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#00D4AA" Width="24"/><TextBlock Text="Reports &amp; export"/></StackPanel>
                        </Button>

                        <TextBlock Text="ADMINISTRATION" Style="{StaticResource NavSection}"/>
                        <Button Tag="10" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="#00D4AA" Width="24"/><TextBlock Text="Settings &amp; users"/></StackPanel>
                        </Button>
                        <Button Tag="11" Click="Navigate_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⇄" Foreground="#00D4AA" Width="24"/><TextBlock Text="Database tools"/></StackPanel>
                        </Button>
                        <Button Click="SignOut_Click" Style="{StaticResource NavButton}" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="←" Foreground="#00D4AA" Width="24"/><TextBlock Text="Sign out"/></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="26,18,22,26">
                    <Border Background="{StaticResource NavyLightBrush}" CornerRadius="9" Padding="12">
                        <StackPanel><TextBlock Text="TILVEX POS" Foreground="#718096" FontSize="10" FontWeight="Bold"/><TextBlock Text="Built for daily trade" Foreground="#E8EDF3" Margin="0,4,0,0"/><TextBlock Text="v1.0 • Local edition" Foreground="#718096" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OperatorText" Text="Good morning, operator" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Business command centre" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="Sales, stock and daily operations" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#141720" CornerRadius="16" Padding="12,7" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="LOCAL DATA ACTIVE" Foreground="#007A5E" FontSize="10" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Button Content="Backup data" Click="BackupData_Click" Style="{StaticResource QuietButton}" Padding="14,8"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#CC141720" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4" Margin="0,0,0,14">
                <TabControl x:Name="MainTabs" ItemContainerStyle="{StaticResource HiddenTabItem}">
                    <TabItem Header="Dashboard">
                        <Grid Margin="10,14,10,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource NavyLightBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="OPERATIONS CONTROL ROOM" Foreground="#00D4AA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BusinessTypeText" Text="Retail" Foreground="#E8EDF3" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="Live local-first activity map" Foreground="#718096" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="SYNC" Foreground="#00D4AA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SyncStatusText" Text="Offline" Foreground="#E8EDF3" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="ALERTS" Foreground="#00D4AA" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="NotificationStatusText" Text="No local notifications" Foreground="#E8EDF3" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right"><TextBlock Text="SEGMENTED WORKFLOWS" Foreground="#00D4AA" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="Sales • Stock • Customers • Suppliers • Till" Foreground="#E8EDF3" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,7,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                            <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,0,16">
                                <Border Background="#B3141720" CornerRadius="9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0" Padding="15"><StackPanel><TextBlock Text="TODAY'S SALES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TodaySalesText" Text="£0.00" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Background="#B3141720" CornerRadius="9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0" Padding="15"><StackPanel><TextBlock Text="TRANSACTIONS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TodayTransactionsText" Text="0" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Background="#B3141720" CornerRadius="9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0" Padding="15"><StackPanel><TextBlock Text="PRODUCTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ProductCountText" Text="0" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Background="#B3141720" CornerRadius="9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0" Padding="15"><StackPanel><TextBlock Text="LOW STOCK" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LowStockText" Text="0" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/><TextBlock x:Name="LowStockDetailText" Text="Stock levels healthy" FontSize="10" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border>
                                <Border Background="#B3141720" CornerRadius="9" BorderBrush="#007A5E" BorderThickness="1" Padding="15"><StackPanel><TextBlock Text="OPEN TILL" Foreground="#007A5E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TillStatusText" Text="Closed" FontSize="19" FontWeight="SemiBold" Foreground="#007A5E" Margin="0,10,0,0"/></StackPanel></Border>
                            </UniformGrid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <GroupBox Header="Revenue signal · last 7 days" Grid.Column="0" Margin="0,0,8,0">
                                            <Grid>
                                                <Canvas x:Name="RevenueTrendCanvas" Height="178" MinWidth="320" ClipToBounds="True"/>
                                                <TextBlock x:Name="RevenueEmptyText" Text="No sales yet — revenue signal will appear here." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </GroupBox>
                                        <GroupBox Header="Top products · units" Grid.Column="1" Margin="8,0,0,0">
                                            <Grid>
                                                <Canvas x:Name="TopProductsCanvas" Height="178" MinWidth="280" ClipToBounds="True"/>
                                                <TextBlock x:Name="TopProductsEmptyText" Text="No product movement yet." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <GroupBox Header="Payment split" Grid.Column="0" Margin="0,0,8,0">
                                            <Grid>
                                                <Canvas x:Name="PaymentDonutCanvas" Height="168" MinWidth="190" ClipToBounds="True"/>
                                                <TextBlock x:Name="PaymentEmptyText" Text="No payments recorded yet." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </GroupBox>
                                        <GroupBox Header="Stock health" Grid.Column="1" Margin="8,0">
                                            <Grid>
                                                <Canvas x:Name="StockHealthCanvas" Height="168" MinWidth="260" ClipToBounds="True"/>
                                                <TextBlock x:Name="StockEmptyText" Text="Add products to monitor stock." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </GroupBox>
                                        <GroupBox Header="Transactions · hour" Grid.Column="2" Margin="8,0,0,0">
                                            <Grid>
                                                <Canvas x:Name="TransactionHourCanvas" Height="168" MinWidth="210" ClipToBounds="True"/>
                                                <TextBlock x:Name="TransactionHourEmptyText" Text="No transaction signal yet." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                    <GroupBox Header="Recent sales">
                                        <DataGrid x:Name="RecentSalesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="190">
                                            <DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="170"/><DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="170"/><DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="80"/><DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="120"/></DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Sales">
                        <Grid Margin="10,14,10,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <GroupBox Header="Products / barcode scanner" Grid.Column="0" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBox x:Name="BarcodeBox" Width="220" ToolTip="Scan or type a barcode/SKU, then press Enter" KeyDown="BarcodeBox_KeyDown"/><Button Content="Add barcode" Click="AddBarcode_Click" Style="{StaticResource QuietButton}" Margin="7,0,12,0"/><TextBox x:Name="ProductSearchBox" Width="230" TextChanged="ProductSearchBox_TextChanged" ToolTip="Search products"/></StackPanel>
                                <TextBlock Grid.Row="1" Text="Select a product to add it to the basket. Barcode scanners work as keyboard input." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                                <DataGrid x:Name="SaleProductsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="SaleProductsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="SKU / Barcode" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="100"/><DataGridTextColumn Header="In stock" Binding="{Binding StockQuantity}" Width="90"/></DataGrid.Columns></DataGrid>
                            </Grid></GroupBox>
                            <GroupBox Header="Current sale" Grid.Column="1"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/><DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:C}}" Width="90"/></DataGrid.Columns></DataGrid>
                                <Grid Grid.Row="1" Margin="0,12,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Customer" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CustomerCombo" DisplayMemberPath="Name"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Promotion code" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PromotionCombo" DisplayMemberPath="Code" SelectionChanged="PromotionCombo_SelectionChanged"/></StackPanel></Grid>
                                <Grid Grid.Row="2" Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Payment" Style="{StaticResource FieldLabel}"/>                                <ComboBox x:Name="PaymentCombo" SelectedIndex="0"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Loyalty points"/><ComboBoxItem Content="Gift card"/><ComboBoxItem Content="On account"/><ComboBoxItem Content="Store credit"/><ComboBoxItem Content="Bank transfer"/><ComboBoxItem Content="Split payment"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Tendered" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TenderedBox" Text="0" TextChanged="TenderedBox_TextChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Change" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ChangeText" Text="£0.00" FontWeight="Bold" FontSize="16" Margin="0,6,0,0"/></StackPanel></Grid>
                                <Grid Grid.Row="3" Margin="0,10,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Subtotal" Style="{StaticResource SectionCaption}"/><TextBlock x:Name="CartSubtotalText" Text="£0.00" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Discount" Style="{StaticResource SectionCaption}"/><TextBlock x:Name="CartDiscountText" Text="£0.00" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="VAT" Style="{StaticResource SectionCaption}"/><TextBlock x:Name="CartTaxText" Text="£0.00" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Total" Style="{StaticResource SectionCaption}"/><TextBlock x:Name="CartTotalText" Text="£0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,1,0,0"/></StackPanel></Grid>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Remove selected" Click="RemoveCartItem_Click" Style="{StaticResource QuietButton}" Margin="0,0,7,0"/><Button Content="Complete &amp; print" Click="CompleteSale_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
                            </Grid></GroupBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Products &amp; Stock">
                        <Grid Margin="10,14,10,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <GroupBox Header="Inventory" Grid.Column="0" Margin="0,0,12,0"><DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="InventoryGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" Width="90"/><DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="90"/><DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="70"/><DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel}" Width="70"/></DataGrid.Columns></DataGrid></GroupBox>
                            <GroupBox Header="Product details" Grid.Column="1"><StackPanel><TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SkuBox" Margin="0,0,0,10"/><TextBlock Text="Barcode" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BarcodeProductBox" Margin="0,0,0,10"/><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Margin="0,0,0,10"/><TextBlock Text="Category" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CategoryBox" Margin="0,0,0,10"/><TextBlock Text="Unit of measure" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UnitCombo" Margin="0,0,0,10"/><TextBlock Text="Display unit label (for example LPG kg)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UnitLabelBox" Margin="0,0,0,10"/><TextBlock Text="Price" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PriceBox" Margin="0,0,0,10"/><TextBlock Text="Stock quantity (supports decimals / kg)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StockBox" Margin="0,0,0,10"/><TextBlock Text="Reorder level" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReorderBox" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Button Content="New" Click="NewProduct_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Save product" Click="SaveProduct_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></GroupBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Sales History"><DataGrid x:Name="SalesHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10,14"><DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="170"/><DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="180"/><DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="90"/><DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="110"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Customers">
                        <Grid Margin="10,14,10,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid x:Name="CustomersGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,12,0" SelectionChanged="CustomersGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/></DataGrid.Columns></DataGrid><GroupBox Header="Customer record" Grid.Column="1"><StackPanel><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerNameBox" Margin="0,0,0,10"/><TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerPhoneBox" Margin="0,0,0,10"/><TextBlock Text="Email" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerEmailBox" Margin="0,0,0,10"/><TextBlock Text="Address" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerAddressBox" Margin="0,0,0,10"/><TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CustomerNotesBox" Height="60" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Button Content="New" Click="NewCustomer_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Save customer" Click="SaveCustomer_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></GroupBox></Grid>
                    </TabItem>
                    <TabItem Header="Suppliers &amp; Purchasing">
                        <Grid Margin="10,14,10,10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="Suppliers" Grid.Column="0" Margin="0,0,10,10"><DataGrid x:Name="SuppliersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="SuppliersGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="130"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/></DataGrid.Columns></DataGrid></GroupBox><GroupBox Header="Supplier details" Grid.Column="1" Margin="10,0,0,10"><StackPanel><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SupplierNameBox" Margin="0,0,0,8"/><TextBlock Text="Contact" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SupplierContactBox" Margin="0,0,0,8"/><TextBlock Text="Phone / email" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SupplierPhoneBox" Margin="0,0,0,8"/><TextBlock Text="Address" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SupplierAddressBox" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button Content="New" Click="NewSupplier_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Save supplier" Click="SaveSupplier_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></GroupBox><GroupBox Header="Purchase order" Grid.Row="1" Grid.ColumnSpan="2"><StackPanel><StackPanel Orientation="Horizontal"><ComboBox x:Name="PurchaseSupplierCombo" DisplayMemberPath="Name" Width="180"/><ComboBox x:Name="PurchaseProductCombo" DisplayMemberPath="Name" Width="220" Margin="8,0,8,0"/><TextBox x:Name="PurchaseQtyBox" Text="1" Width="55" Margin="0,0,8,0"/><TextBox x:Name="PurchaseCostBox" Text="0" Width="75" Margin="0,0,8,0"/><Button Content="Add line" Click="AddPurchaseLine_Click" Style="{StaticResource QuietButton}"/><Button Content="Receive order" Click="ReceivePurchase_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel><DataGrid x:Name="PurchaseOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="115" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding Number}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></GroupBox></Grid>
                    </TabItem>
                    <TabItem Header="Returns &amp; Refunds"><Grid Margin="10,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="Process a return"><StackPanel Orientation="Horizontal"><TextBox x:Name="ReturnReceiptBox" Width="210" ToolTip="Receipt number"/><TextBox x:Name="ReturnReasonBox" Width="260" Margin="8,0,8,0" ToolTip="Reason"/><Button Content="Refund receipt" Click="RefundReceipt_Click"/></StackPanel></GroupBox><DataGrid x:Name="ReturnsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="180"/><DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="180"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Refund" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="110"/></DataGrid.Columns></DataGrid></Grid></TabItem>
                    <TabItem Header="Promotions &amp; VAT"><Grid Margin="10,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="Discount promotions" Grid.Column="0" Margin="0,0,10,0"><StackPanel><DataGrid x:Name="PromotionsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="260" SelectionChanged="PromotionsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Discount" Binding="{Binding DiscountPercent, StringFormat={}{0:0.##}%}" Width="90"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60"/></DataGrid.Columns></DataGrid><TextBox x:Name="PromotionNameBox" Margin="0,10,0,6" ToolTip="Promotion name"/><StackPanel Orientation="Horizontal"><TextBox x:Name="PromotionCodeBox" Width="100" ToolTip="Code"/><TextBox x:Name="PromotionPercentBox" Width="80" Margin="6,0,6,0" ToolTip="Percent"/><Button Content="Save promotion" Click="SavePromotion_Click"/></StackPanel></StackPanel></GroupBox><GroupBox Header="VAT / tax configuration" Grid.Column="1" Margin="10,0,0,0"><StackPanel><TextBlock Text="Tax name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TaxNameBox" Margin="0,0,0,12"/><TextBlock Text="Rate (%)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TaxRateBox" Margin="0,0,0,12"/><CheckBox x:Name="TaxInclusiveBox" Content="Prices include VAT" Margin="0,0,0,16"/><Button Content="Save tax settings" Click="SaveTax_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></GroupBox></Grid></TabItem>
                    <TabItem Header="Till &amp; Reconciliation"><Grid Margin="10,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="Cash drawer"><StackPanel Orientation="Horizontal"><TextBlock Text="Opening float" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpeningFloatBox" Text="0" Width="90" Margin="8,0,14,0"/><Button Content="Open till" Click="OpenTill_Click"/><TextBlock Text="Counted cash" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="20,0,0,0"/><TextBox x:Name="CountedCashBox" Text="0" Width="90" Margin="8,0,14,0"/><Button Content="Close &amp; reconcile" Click="CloseTill_Click"/></StackPanel></GroupBox><DataGrid x:Name="TillGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Opened" Binding="{Binding OpenedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="180"/><DataGridTextColumn Header="Closed" Binding="{Binding ClosedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="180"/><DataGridTextColumn Header="Opening" Binding="{Binding OpeningFloat, StringFormat={}{0:C}}" Width="110"/><DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash, StringFormat={}{0:C}}" Width="110"/><DataGridTextColumn Header="Counted" Binding="{Binding CountedCash, StringFormat={}{0:C}}" Width="110"/><DataGridTextColumn Header="Variance" Binding="{Binding Variance, StringFormat={}{0:C}}" Width="110"/></DataGrid.Columns></DataGrid></Grid></TabItem>
                    <TabItem Header="Reports &amp; Export"><StackPanel Margin="10,18"><TextBlock Text="Daily / weekly / monthly owner reports" Style="{StaticResource PageTitle}" FontSize="20"/><TextBlock Text="Reports are generated locally first and are ready for Google Drive / Google Sheets export when configured." Style="{StaticResource SectionCaption}" Margin="0,6,0,0"/><TextBlock x:Name="ReportSummaryText" Margin="0,10,0,20" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="ReportPeriodCombo" Width="120" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/><ComboBoxItem Content="Monthly"/></ComboBox><Button Content="Refresh report" Click="RefreshReport_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Export period CSV" Click="ExportPeriodCsv_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Export sales CSV" Click="ExportSalesCsv_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Export inventory CSV" Click="ExportInventoryCsv_Click" Style="{StaticResource QuietButton}"/></StackPanel></StackPanel></TabItem>
                    <TabItem Header="Settings &amp; Users"><Grid Margin="10,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="Business details &amp; configurable operations" Grid.Column="0" Margin="0,0,10,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Business name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BusinessNameBox" Margin="0,0,0,9"/><TextBlock Text="Business type" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BusinessTypeCombo" Margin="0,0,0,9"/><TextBlock Text="Address" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BusinessAddressBox" Margin="0,0,0,9"/><TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BusinessPhoneBox" Margin="0,0,0,9"/><TextBlock Text="Replaceable company logo path (optional)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CompanyLogoBox" Margin="0,0,0,9"/><TextBlock Text="Receipt footer" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReceiptFooterBox" Height="55" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,9"/><TextBlock Text="Low-stock alert threshold" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LowStockThresholdBox" Margin="0,0,0,9"/><TextBlock Text="Owner email for low-stock alerts" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OwnerEmailBox" Margin="0,0,0,9"/><CheckBox x:Name="SaleNotificationsBox" Content="Record sale timestamp notifications locally"/><CheckBox x:Name="OwnerEmailAlertsBox" Content="Enable owner email alert hook" Margin="0,2,0,14"/><Button Content="Save business settings (Admin)" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></ScrollViewer></GroupBox><StackPanel Grid.Column="1"><GroupBox Header="Users &amp; permissions"><StackPanel><TextBlock Text="Cashier: sales and till • Manager: purchasing and reports • Admin: configuration" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="180"><DataGrid.Columns><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="UserNameBox" Width="130" ToolTip="User name"/><ComboBox x:Name="RoleCombo" Width="110" Margin="6,0,6,0"><ComboBoxItem Content="Cashier"/><ComboBoxItem Content="Manager"/><ComboBoxItem Content="Admin"/></ComboBox><Button Content="Add user" Click="AddUser_Click"/></StackPanel></StackPanel></GroupBox><GroupBox Header="Online sync &amp; communications (optional hooks)" Margin="0,12,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" Height="245"><StackPanel><CheckBox x:Name="SyncEnabledBox" Content="Enable online sync (sales remain safe locally)"/><TextBox x:Name="SyncEndpointBox" ToolTip="HTTP sync endpoint" Margin="0,5,0,0"/><TextBox x:Name="SyncApiKeyBox" ToolTip="****** key (optional)" Margin="0,5,0,0"/><TextBox x:Name="GoogleDriveFolderBox" ToolTip="Google Drive folder ID for report export" Margin="0,5,0,0"/><TextBox x:Name="GoogleSheetsIdBox" ToolTip="Google Sheets spreadsheet ID" Margin="0,5,0,0"/><TextBox x:Name="GoogleSheetsTabBox" Text="Sales" ToolTip="Google Sheets worksheet" Margin="0,5,0,0"/><TextBox x:Name="WhatsAppWebhookBox" ToolTip="WhatsApp webhook (optional)" Margin="0,5,0,0"/><TextBox x:Name="SmsWebhookBox" ToolTip="SMS webhook (optional)" Margin="0,5,0,0"/><TextBox x:Name="EmailWebhookBox" ToolTip="Email webhook (optional)" Margin="0,5,0,8"/><TextBlock Text="WhatsApp / SMS / email / Google Sheets are configuration-ready HTTP hooks; no external package or network is required." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="Save settings and sync now" Click="SyncNow_Click"/></StackPanel></ScrollViewer></GroupBox><GroupBox Header="Custom workflows / screens" Margin="0,12,0,0"><StackPanel><DataGrid x:Name="WorkflowsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="120"><DataGrid.Columns><DataGridTextColumn Header="Screen" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="WorkflowNameBox" Width="130" ToolTip="Screen name"/><TextBox x:Name="WorkflowDescriptionBox" Width="180" Margin="6,0,6,0" ToolTip="Description"/><Button Content="Add workflow" Click="AddWorkflow_Click"/></StackPanel></StackPanel></GroupBox></StackPanel></Grid></TabItem>
                    <TabItem Header="Database Tools"><StackPanel Margin="10,18"><TextBlock Text="Migration and import tools" Style="{StaticResource PageTitle}" FontSize="20"/><TextBlock Text="The local JSON file is automatically versioned. Export a complete copy before moving to another machine, or import a previously exported copy." TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal"><Button Content="Export JSON" Click="ExportJson_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Import JSON" Click="ImportJson_Click"/><TextBlock x:Name="DatabaseStatusText" Margin="14,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel></TabItem>
                </TabControl>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,8,0,0">
                <TextBlock Text="TILVEX POS" Foreground="#718096" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="  by  " Foreground="#718096" FontSize="11"/>
                <TextBlock Text="Grey InfoTech" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
