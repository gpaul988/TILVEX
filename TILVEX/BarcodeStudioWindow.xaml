<Window x:Class="TILVEX.BarcodeStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode Studio | TILVEX" Width="1180" Height="780" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172334"/>
        <SolidColorBrush x:Key="Muted" Color="#6B778A"/>
        <SolidColorBrush x:Key="Accent" Color="#0F9F78"/>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172334"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F9F78"/>
            <Setter Property="BorderBrush" Value="#0F9F78"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="#344256"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="BARCODE STUDIO" Foreground="#0F9F78" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Design. Generate. Label." Foreground="#172334" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,3"/>
                <TextBlock Text="Create standards-compliant, scanner-ready product labels and print them in batches."
                           Foreground="#6B778A" FontSize="13"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Background="#E2F5EF" Padding="12,7">
                <TextBlock Text="LOCAL • READY" Foreground="#087956" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="1  SELECT PRODUCTS" Foreground="#172334" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Ctrl-click or Shift-click for batch labels" Foreground="#778498" FontSize="11" Margin="0,5,0,12"/>
                    </StackPanel>
                    <TextBox x:Name="ProductSearchBox" Grid.Row="1" Margin="0,0,0,10"
                             ToolTip="Search by product, SKU or barcode" TextChanged="ProductSearchBox_TextChanged"/>
                    <ListBox x:Name="ProductsList" Grid.Row="2" SelectionMode="Extended"
                             SelectionChanged="ProductsList_SelectionChanged"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="7,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="#172334" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sku}" Foreground="#778498" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N2}}"
                                                   Foreground="#0B805E" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ProductCountText" Grid.Row="3" Foreground="#778498" FontSize="11" Margin="0,10,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E7EF" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="2  CONFIGURE LABEL" Foreground="#172334" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="SelectionSummaryText" Text="Choose a product to preview its label"
                                       Foreground="#778498" FontSize="11" Margin="0,5,0,14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ZOOM" Foreground="#778498" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="ZoomSlider" Width="105" Minimum="0.65" Maximum="1.5" Value="1"
                                    ValueChanged="ZoomSlider_ValueChanged"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Barcode format" Foreground="#66758A" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FormatCombo" SelectionChanged="LabelSetting_Changed">
                                    <ComboBoxItem Content="Code 128"/>
                                    <ComboBoxItem Content="EAN-13"/>
                                    <ComboBoxItem Content="UPC-A"/>
                                    <ComboBoxItem Content="QR Code"/>
                                </ComboBox>
                                <TextBlock Text="Label size" Foreground="#66758A" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <ComboBox x:Name="SizeCombo" SelectionChanged="LabelSetting_Changed">
                                    <ComboBoxItem Content="50 × 30 mm"/>
                                    <ComboBoxItem Content="60 × 40 mm"/>
                                    <ComboBoxItem Content="100 × 50 mm"/>
                                </ComboBox>
                                <TextBlock Text="Code value" Foreground="#66758A" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <TextBox x:Name="CodeBox" TextChanged="LabelText_Changed"/>
                                <Button Content="Generate valid code" Click="GenerateCode_Click" Margin="0,7,0,0"/>
                                <TextBlock Text="Label text" Foreground="#66758A" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <TextBox x:Name="LabelNameBox" TextChanged="LabelText_Changed"/>
                                <TextBlock Text="Secondary line" Foreground="#66758A" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <TextBox x:Name="LabelDetailBox" TextChanged="LabelText_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Font (pt)" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FontSizeBox" Text="9" Width="68" TextChanged="LabelText_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Text limit" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TextLimitBox" Text="24" Width="68" TextChanged="LabelText_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Padding (mm)" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PaddingBox" Text="2" Width="82" TextChanged="LabelText_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Sheet gap (mm)" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SheetGapBox" Text="2" Width="92" TextChanged="LabelText_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Page margin (mm)" Foreground="#66758A" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PageMarginBox" Text="10" Width="92" TextChanged="LabelText_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <CheckBox x:Name="ShowPriceCheck" Content="Show price" IsChecked="True" Checked="LabelSetting_Changed" Unchecked="LabelSetting_Changed"/>
                                    <TextBox x:Name="QuantityBox" Text="1" Width="60" Margin="12,0,0,0" ToolTip="Copies per selected product"/>
                                    <TextBlock Text="copies" Foreground="#66758A" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Column="2" Background="#F2F5F9" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="LIVE LABEL PREVIEW" Foreground="#66758A" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="PreviewSizeText" HorizontalAlignment="Right" Foreground="#66758A" FontSize="10"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid MinWidth="400" MinHeight="290">
                                        <Border Background="White" BorderBrush="#DDE5ED" BorderThickness="1" CornerRadius="5"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                                            <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                                <TextBlock x:Name="PreviewStatusText" Grid.Row="2" Text="A real barcode preview will appear here"
                                           Foreground="#6B778A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Save code to product" Click="SaveCode_Click"/>
                        <Button Content="Copy label" Click="CopyLabel_Click"/>
                        <Button Content="Export PNG" Click="ExportPng_Click"/>
                        <Button Content="PDF preview" Click="PdfPreview_Click"/>
                        <Button Content="Print labels" Style="{StaticResource PrimaryButton}" Click="PrintLabels_Click" Margin="0" Padding="10,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#E8F7F2" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
            <TextBlock Text="Use GS1-assigned EAN/UPC numbers • Check digits validated • Batch output, PNG and PDF stay local"
                       Foreground="#087956" FontSize="11"/>
        </Border>
    </Grid>
</Window>
