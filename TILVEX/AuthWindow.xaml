<Window x:Class="TILVEX.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TILVEX Sign In"
        Width="1100" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="Assets/tilvex-icon.png"
        Background="#0B1726">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandDark" Color="#0B1726"/>
        <SolidColorBrush x:Key="BrandTeal" Color="#00C7B7"/>
        <SolidColorBrush x:Key="BrandTealDeep" Color="#0AA89A"/>
        <SolidColorBrush x:Key="BrandSoft" Color="#EAFBF8"/>
        <SolidColorBrush x:Key="PanelSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#5A6B82"/>
        <SolidColorBrush x:Key="Line" Color="#DFEAF3"/>

        <Style x:Key="AuthInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="BorderBrush" Value="#D7E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AuthPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="BorderBrush" Value="#D7E3EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryAuthButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#00C7B7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryAuthButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#EEF7F6"/>
            <Setter Property="Foreground" Value="#0B1726"/>
            <Setter Property="BorderBrush" Value="#CDECE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrandDark}">
            <Grid Margin="48,36,48,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Viewbox Width="42" Height="42" Stretch="Uniform">
                        <Canvas Width="512" Height="512">
                            <Border Width="512" Height="512" CornerRadius="110" Background="{StaticResource BrandTeal}"/>
                            <Polygon Points="256,52 358,102 400,230 358,358 256,408 154,358 112,230 154,102"
                                     Fill="Transparent" Stroke="White" StrokeThickness="5" Opacity="0.2"/>
                            <Rectangle Canvas.Left="130" Canvas.Top="134" Width="252" Height="58" RadiusX="14" RadiusY="14" Fill="{StaticResource BrandDark}"/>
                            <Rectangle Canvas.Left="220" Canvas.Top="190" Width="72" Height="110" RadiusX="12" RadiusY="12" Fill="{StaticResource BrandDark}"/>
                            <Polygon Points="220,300 292,300 368,398 292,398 254,344 220,344" Fill="{StaticResource BrandTealDeep}"/>
                            <Rectangle Canvas.Left="254" Canvas.Top="330" Width="72" Height="72" RadiusX="12" RadiusY="12" Fill="{StaticResource BrandTealDeep}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TILVEX" Foreground="White" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Manage sales, stock, and customers with confidence." Foreground="White" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" Width="430" LineHeight="48"/>
                    <TextBlock Margin="0,18,0,0" Foreground="#B6CAD8" FontSize="17" TextWrapping="Wrap" Width="430" LineHeight="28">
                        Sign in to your TILVEX workspace or create a new account to access your point-of-sale dashboard.
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="2" Padding="18,14" Background="#12233D" CornerRadius="16" Width="340" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Foreground="#A9D7D3" FontSize="12" Text="WORKSPACE STATUS" FontWeight="SemiBold"/>
                        <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0">Secure cloud-ready access</TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F4F8FB">
            <TabControl Margin="42,20,42,20" Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,10" Margin="0,0,24,0">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#00C7B7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="#4A5E78"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Sign in">
                    <Grid Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Welcome back" FontSize="34" FontWeight="SemiBold" Foreground="#0B1726"/>
                        <TextBlock Grid.Row="1" Margin="0,8,0,28" Foreground="#5A6B82" FontSize="16">
                            Use your email and password to access your store.
                        </TextBlock>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Email address" Foreground="#485E7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="LoginEmail" Style="{StaticResource AuthInput}" Text="admin@tilvex.local"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock Text="Password" Foreground="#485E7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="LoginPassword" Style="{StaticResource AuthPassword}" Password="Tilvex123!"/>
                        </StackPanel>

                        <Button Grid.Row="4" Margin="0,28,0,0" Style="{StaticResource PrimaryAuthButton}" Content="Sign in" Click="LoginButton_Click"/>

                        <Border Grid.Row="5" Margin="0,24,0,0" Padding="16,12" Background="#EAFBF8" CornerRadius="10" BorderBrush="#CDECE6" BorderThickness="1">
                            <TextBlock Foreground="#0F6D5F" Text="Default admin access: admin@tilvex.local / Tilvex123!" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Create account">
                    <Grid Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Create your account" FontSize="34" FontWeight="SemiBold" Foreground="#0B1726"/>
                        <TextBlock Grid.Row="1" Margin="0,8,0,28" Foreground="#5A6B82" FontSize="16">
                            Start a new store workspace in seconds.
                        </TextBlock>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Full name" Foreground="#485E7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="SignupName" Style="{StaticResource AuthInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock Text="Email address" Foreground="#485E7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox x:Name="SignupEmail" Style="{StaticResource AuthInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,18,0,0">
                            <TextBlock Text="Password" Foreground="#485E7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="SignupPassword" Style="{StaticResource AuthPassword}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,18,0,0">
                            <TextBlock Text="Confirm password" Foreground="#485E7B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="SignupConfirmPassword" Style="{StaticResource AuthPassword}"/>
                        </StackPanel>

                        <Button Grid.Row="6" Margin="0,28,0,0" Style="{StaticResource PrimaryAuthButton}" Content="Create account" Click="SignupButton_Click"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
